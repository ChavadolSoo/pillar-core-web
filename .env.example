# Pillar Core website (Auth.js + Keycloak client "pillar-web"). Copy to .env.local.
# Public URL of this site; must match the pillar-web redirect URI in Keycloak
# (dev: http://localhost:3200, prod: https://<domain>)
AUTH_URL=http://localhost:3200
# openssl rand -base64 32
AUTH_SECRET=
AUTH_KEYCLOAK_ISSUER=http://localhost:8080/realms/pillarcore
AUTH_KEYCLOAK_ID=pillar-web
# = PILLAR_WEB_CLIENT_SECRET in pillar-core-backend/infra/.env
AUTH_KEYCLOAK_SECRET=dev-pillar-web-secret
# Social sign-in buttons to show (Keycloak identity provider aliases):
# any of google,facebook,line,github. Configure them with
# pillar-core-backend/infra/keycloak/setup-web-client.sh first.
AUTH_SOCIAL_PROVIDERS=
# plc-gateway
API_BASE_URL=http://localhost:3000
# Shown in the footer and the help center
NEXT_PUBLIC_CONTACT_EMAIL=support@pillarcore.app
